{
  "manifest_version": 3,
  "name": "FACEIT Autopilot",
  "version": "1.0.0",
  "key": "",
  "description": "Auto-accept FACEIT matches and auto-ban maps by your priority list.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FACEIT Autopilot",
    "default_icon": {
      "16": "icons/app16.png",
      "32": "icons/app32.png",
      "48": "icons/app48.png",
      "128": "icons/app128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*"],
      "matches": ["https://www.faceit.com/*"]
    }
  ],
  "icons": {
    "16": "icons/app16.png",
    "32": "icons/app32.png",
    "48": "icons/app48.png",
    "128": "icons/app128.png"
  }
}